{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": { "api/proxy.js": { "maxDuration": 20 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
  ] }],
  "rewrites": [
    { "source": "/_network/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/roadmap", "destination": "/roadmap.html" },
    { "source": "/roadmap/:path*", "destination": "https://solana-classic-roadmap.vercel.app/:path*" },
    { "source": "/playground", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/explorer", "destination": "/index.html" },
    { "source": "/explorer/:path*", "destination": "/index.html" },
    { "source": "/network", "destination": "/index.html" },
    { "source": "/token", "destination": "/index.html" }
    ,{ "source": "/about", "destination": "/index.html" }
  ]
}
