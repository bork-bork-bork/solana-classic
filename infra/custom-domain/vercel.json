{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 20
    },
    "api/developer-rpc.js": {
      "maxDuration": 20
    },
    "api/developer-api.js": {
      "maxDuration": 20
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "rpc.solanaclassic.net"
        }
      ],
      "dest": "/api/developer-rpc?path=$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "api.solanaclassic.net"
        }
      ],
      "dest": "/api/developer-api?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/chain\\-assets(?:/(.*))?/?$",
      "dest": "/api/asset-proxy?path=$1"
    },
    {
      "src": "^/uploaded\\-assets(?:/(.*))?/?$",
      "dest": "/api/uploaded-asset-proxy?path=$1"
    },
    {
      "src": "^/_network(?:/(.*))?/?$",
      "dest": "/api/proxy?path=$1"
    },
    {
      "src": "^/roadmap/?$",
      "dest": "/roadmap.html"
    },
    {
      "src": "^/roadmap(?:/(.*))?/?$",
      "dest": "https://solana-classic-roadmap.vercel.app/$1"
    },
    {
      "src": "^/playground/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/wallet/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/gallery/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/builders/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/developers/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/collectors/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/collectors(?:/(.*))?/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/explorer/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/explorer(?:/(.*))?/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/network/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/token/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/whitepaper/?$",
      "dest": "/index.html"
    }
  ]
}
